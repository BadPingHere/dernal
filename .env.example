# Discord bot token, pretty self explanatory.
TOKEN=YOUR_BOT_TOKEN_HERE
# If you intend to use this for a specific server, entering it's server id here will make everything show up MUCH faster. Leave blank for no specific server bot command loading.
SERVER_ID=YOUR_SERVER_ID_HERE
#API user-keys you get from creating an account at https://wynncraft.com/account. Unsure if we will ever user them to its fullest, but nontheless just put the keys in csv format, no spaces, no limit
KEYS=KEY_1_HERE,KEY_2_HERE,KEY_3_HERE
# Switch to enable dashboard or not. 1 to turn on the api for dashboard, 0 to not.
DASHBOARD=1_OR_0
# Base URL for the API. Swith to your heart's desires.
API_BASE_URL=http://localhost:8080

# Most of this you leave default, you can change host/port if you want to connect to a external setup.
PG_HOST=localhost
PG_PORT=5433
# Use 0.0.0.0 if you want this reachable by LAN, 127.0.0.1 if you want this only reachable locally
PG_BIND=0.0.0.0
PG_DB=dernal
PG_USER=postgres
PG_PASSWORD=CHANGE_ME
TIMESCALE_CONTAINER=dernal-timescale